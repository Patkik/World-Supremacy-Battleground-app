# Production template; do not replace .env.docker or enable local-testing here.
# Public web settings are baked into the web bundle; rebuild after changing them.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
NEXT_PUBLIC_WSB_LOCAL_TESTING=false
# Server configuration. Supply workload identity/ADC through the hosting platform.
FIREBASE_PROJECT_ID=
WEB_ORIGIN=
WSB_STORAGE=firestore
WSB_ENABLE_PRODUCTION_STORAGE=false
# Set true only for intentional ADC-backed, non-demo Firestore deployment.
# Readiness remains closed until migration and release verification are complete.

# Server-only PayMongo adapter settings. Empty credentials keep checkout unavailable.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_LIVE_MODE=false
PAYMONGO_API_BASE_URL=https://api.paymongo.com
PAYMONGO_PAYMENT_METHOD_TYPES=
WSB_PUBLIC_WEB_URL=
