{
  "name": "wsb-platform",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run dev --workspace @wsb/web",
    "build": "npm run build --workspace @wsb/web",
    "typecheck": "npm run typecheck --workspace @wsb/web",
    "emulators": "firebase emulators:start --project demo-wsb",
    "test:rules": "firebase emulators:exec --project demo-wsb --only firestore \"node --test tests/firestore.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase-tools": "15.34.2"
  }
}
