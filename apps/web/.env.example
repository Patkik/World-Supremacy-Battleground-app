# Local development defaults to isolated Firebase emulators.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-wsb.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-wsb
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-wsb.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demo
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_API_URL=http://localhost:8088
NEXT_PUBLIC_SITE_URL=

# Outgoing transactional email
# Trusted origin for emulator-only account links; never inferred from request headers.
WEB_ORIGIN=http://localhost:3100
WSB_SMTP_HOST=smtp.gmail.com
WSB_SMTP_PORT=465
WSB_SMTP_USER=
WSB_SMTP_PASS=
WSB_SMTP_FROM=
